{
  "name": "relay-agent-workspace",
  "productName": "Relay",
  "version": "0.1.0",
  "description": "A desktop workspace for shared-model agent sessions",
  "author": "Relay",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/smoke.mjs",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --linux AppImage",
    "format": "prettier --write src electron/*.mjs electron/*.cjs scripts/*.mjs tests/*.mjs vite.config.ts package.json tsconfig.json index.html"
  },
  "dependencies": {
    "css-tree": "^3.2.1",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "jsdom": "^30.1.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.56.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  },
  "build": {
    "appId": "dev.relay.agents",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "build/icon.png",
      "skills/**"
    ],
    "asarUnpack": [
      "electron/localai_bridge.py"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "syncDesktopName": true
    },
    "icon": "build/icon.png"
  },
  "desktopName": "relay.desktop"
}
