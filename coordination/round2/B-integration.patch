+/* Agent B: truthful lifecycle states + the experimental delegation switch.
+   Colour is never the only signal: every state also has its own text label. */
+.state-label.waiting_children > span {
+  background: var(--accent);
+}
+.state-label.stopped > span,
+.state-label.interrupted > span {
+  background: var(--amber);
+}
+.state-label.failed > span {
+  background: #d18b8b;
+}
+.state-label.unknown > span {
+  background: #777c86;
+}
+.queue-notice strong {
+  font-weight: 600;
+}
+.delegation-toggle {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  font-size: 10px;
+  color: var(--muted);
+  cursor: pointer;
+}
+.delegation-toggle em {
+  font-style: normal;
+  font-size: 8px;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+  opacity: 0.7;
+  margin-left: 4px;
+}
+.delegation-toggle.on {
+  color: var(--accent);
+}
+.delegation-toggle.locked {
+  opacity: 0.55;
+  cursor: not-allowed;
+}
+@media (prefers-reduced-motion: reduce) {
+  .queue-notice .spin {
+    animation: none;
+  }
+}
